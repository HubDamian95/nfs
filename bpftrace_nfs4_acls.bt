#!/usr/bin/env bpftrace
/*
 * Trace NFSv4 ACL reads on the client, and tell cache hits from server fetches.
 *
 *   lookup  every call into nfs4_proc_get_acl(), the getxattr path for
 *           system.nfs4_acl. This includes calls answered from the cache.
 *   WIRE    the nfs4_get_acl tracepoint, which fires only when the client
 *           actually asked the server (nfs4_get_acl_uncached()).
 *
 * A lookup with no WIRE line after it was served from the ACL cache.
 *
 * NFSv4 ACLs are an opaque blob in the client, not a struct posix_acl, so
 * this script records who is asking and not ACL entries. To see the entries,
 * read them with nfs4_getfacl.
 *
 * Checked against Linux v6.8 source. nfs4_proc_get_acl() is static: if the
 * kprobe cannot attach (symbol inlined or renamed on your kernel), keep the
 * tracepoint, which is stable.
 */

tracepoint:nfs4:nfs4_get_acl
{
	@wire[comm] = count();
	printf("%-16s pid=%-7d WIRE    fileid=%llu error=%lu\n",
	       comm, pid, args->fileid, args->error);
}

kprobe:nfs4_proc_get_acl
{
	@lookups[comm] = count();
	printf("%-16s pid=%-7d lookup\n", comm, pid);
}

END
{
	printf("\nACL lookups per process (cache hits + fetches):\n");
	print(@lookups);
	printf("\nACL fetches from the server per process:\n");
	print(@wire);
}
